# Required for the 'gemini' backend (Gemma 4 via the Gemini API) and the Git safety reviewer.
# Get a free key at https://aistudio.google.com and never commit your real .env file.
GEMINI_API_KEY=your_api_key_here

# Models
GEMMA_MODEL=gemma-4-26b-a4b-it
GEMINI_MODEL=gemini-2.5-flash

# Main backend: 'gemini' (default) or 'ollama' (local, offline)
BACKEND=gemini

# Used only when BACKEND=ollama
OLLAMA_MODEL=gemma4:e4b
OLLAMA_URL=http://localhost:11434

# Optional: raises the GitHub API rate limit when fetching issues
# GITHUB_TOKEN=
